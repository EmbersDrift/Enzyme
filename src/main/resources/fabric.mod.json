{
  "schemaVersion": 1,
  "id": "packmod",
  "version": "${version}",
  "name": "Enzyme",
  "icon": "assets/packmod/icon.png",
  "description": "Inspect and convert Minecraft resource packs using the 2-Pyramid core.",
  "authors": [
    "EmbersDrift",
    "Embers Client contributors"
  ],
  "license": "MIT",
  "contact": {
    "homepage": "https://github.com/EmbersDrift/Enzyme",
    "sources": "https://github.com/EmbersDrift/Enzyme",
    "issues": "https://github.com/EmbersDrift/Enzyme/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.embers.packmod.PackModClient"
    ]
  },
  "mixins": [
    "packmod.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
